  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>

    <Description>Wraps Scalar.AspNetCore to standardize its use and integration with other Lexicom packages.</Description>
    <PackageTags>scalar;openapi;dependencyinjection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.20" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.12" />
  </ItemGroup>

</Project>
