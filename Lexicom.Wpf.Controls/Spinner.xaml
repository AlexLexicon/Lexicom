<UserControl
    x:Class="Lexicom.Wpf.Controls.Spinner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="cSpinner"
    d:DesignHeight="32"
    d:DesignWidth="32">

    <Viewbox>
        <Grid
            Width="32"
            Height="32">
            <Rectangle
                Width="32"
                Height="32"
                d:Stroke="#FFADB2B5"
                d:StrokeThickness="8"
                RadiusX="16"
                RadiusY="16"
                Stroke="{Binding RingBackground, ElementName=cSpinner}"
                StrokeThickness="{Binding RingStrokeThickness, ElementName=cSpinner}" />
            <Grid
                d:Visibility="Visible"
                RenderTransformOrigin="0.5,0.5">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />

                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetProperty="(Grid.RenderTransform).(RotateTransform.Angle)"
                                            To="360"
                                            Duration="0:0:2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=cSpinner}">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RenderTransform>
                    <RotateTransform />
                </Grid.RenderTransform>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid ClipToBounds="True">
                        <Rectangle
                            Width="32"
                            Height="32"
                            d:Stroke="#FF7EB4EA"
                            d:StrokeThickness="8"
                            RadiusX="16"
                            RadiusY="16"
                            Stroke="{Binding RingForeground, ElementName=cSpinner}"
                            StrokeThickness="{Binding RingStrokeThickness, ElementName=cSpinner}" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Grid.Column="1"
                        ClipToBounds="True">
                        <Rectangle
                            Width="32"
                            Height="32"
                            Margin="-16,-16,0,0"
                            d:Stroke="#FF7EB4EA"
                            d:StrokeThickness="8"
                            RadiusX="16"
                            RadiusY="16"
                            Stroke="{Binding RingForeground, ElementName=cSpinner}"
                            StrokeThickness="{Binding RingStrokeThickness, ElementName=cSpinner}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
