<Label
    x:Class="Lexicom.Wpf.Controls.ToggleButtonForegroundImage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="cToggleButtonForegroundImage"
    Padding="0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:DesignHeight="64"
    d:DesignWidth="64"
    Background="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">

    <Label.OpacityMask>
        <ImageBrush ImageSource="{Binding ImageSource, ElementName=cToggleButtonForegroundImage}" />
    </Label.OpacityMask>

</Label>
